        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "lucide-react": "^1.47.0",
        "mammoth": "^1.13.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tinymce": "^8.10.1",
        "tinymce-i18n": "^26.11.2",
