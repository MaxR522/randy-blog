{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check && node scripts/tailwind-canonical.mjs",
        "check:fix": "vp check --fix && node scripts/tailwind-canonical.mjs --fix",
        "tailwind:canonical": "node scripts/tailwind-canonical.mjs",
        "types:check": "tsc --noEmit"
    },
