APP_NAME="Randy Donny"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The blog is French only (spec §6.1)
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Dates are stored in UTC and displayed in this timezone (spec Q4)
APP_DISPLAY_TIMEZONE=Indian/Antananarivo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# Database (PostgreSQL 18)
# =============================================================================
# 127.0.0.1 works for commands run from the host (php artisan test, ...).
# Inside Docker, docker-compose.yml overrides DB_HOST with "postgres".
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=randy_blog
DB_USERNAME=randy
DB_PASSWORD=password

# Sessions: 120 minutes of inactivity (ADM-AUTH-4)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# =============================================================================
# Mail (Mailpit in development: http://localhost:8025)
# =============================================================================
# Inside Docker, docker-compose.yml overrides MAIL_HOST/MAIL_PORT.
# Production provider: to be chosen (spec §7.6, Q3).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@randy-donny.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# Octane (FrankenPHP)
# =============================================================================
OCTANE_SERVER=frankenphp

# =============================================================================
# Inertia SSR
# =============================================================================
# In development the Vite dev server renders pages (docker-compose.yml sets
# INERTIA_SSR_HOT_URL=http://vite:5173). In production, the SSR server runs
# in the same container as the app.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Cloudinary: covers, in-content images, avatars (spec §7.5)
# =============================================================================
CLOUDINARY_URL=

# =============================================================================
# Google Analytics 4 (spec §7.6)
# =============================================================================
# Tracking tag, loaded after cookie consent
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-5ZEWQRGZV5
# Admin dashboard (GA4 Data API): property ID and service account JSON key
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_CREDENTIALS_JSON=
